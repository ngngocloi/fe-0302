@{
   Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width"/>
    <title> Dinh dang table </title>
    <style type="text/css">
        table{
            border:  3px solid red;
            border-collapse: collapse;
            width: 300px;
            height: 250px
        }
        th{
            border: 1px solid blue;
            background-color: deepskyblue;
            font: bold 15px;
            color: white;
        }
        td {
            color: black;
            border: 1px solid blue;
            font-family: Arial,'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
            text-align: center;
            font-size: 12px;
        }
        .tr_le{
            background-color: lightpink;
        }

        .tr_chan{
            background-color: dodgerblue;
        }

    </style>
</head>
<body>
    <table>
        <tr>
            <th>header1</th>
            <th>header2</th>
            <th>header3</th>
        </tr>
        <tr class="tr_le">
            <td>column1</td>
            <td>column2</td>
            <td>column3</td>
        </tr>
        <tr class="tr_chan">
            <td>column1</td>
            <td>column2</td>
            <td>column3</td>
        </tr>
        <tr class="tr_le">
            <td>column1</td>
            <td>column2</td>
            <td>column3</td>
        </tr>
        <tr class="tr_chan">
            <td>column1</td>
            <td>column2</td>
            <td>column3</td>
        </tr>
    </table>
</body>
</html>