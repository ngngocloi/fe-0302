@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Bo cuc trang web - layout</title>
    <style type="text/css">
        body{
            background-color: whitesmoke;
            font-family: Arial, 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;

        }
        #container{
            border: 5px solid #000000;
            width: 70%;
            background-color: aquamarine;
            margin:  30px auto;
        }
        #mainmenu{
            background-color: palevioletred;
            color:white;
            font-size: 25px;
            text-align: center;
        }
        #header{
            background-color: dimgray;
            color: white;
            height: 100px;
            text-align:center;
            border-top: 3px solid black;
            border-bottom: 3px solid black;
        }
        #slidebar{
            background-color: gray;
            color: white;
            width: 20%;
            float: left;
            min-height: 450px;
        }
        #content{
            background-color: whitesmoke;
            color: white;
            min-height: 450px;
            margin-left: 20%;
            border: 3px solid black;
        }
        #footer {
            background-color: saddlebrown;
            color: white;
            right: 20px;
            height: 30px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div id="container">
        <div id="mainmenu">Main menu</div>
        <div id="header">Header</div>
        <div id="slidebar">Slidebar</div>
        <div id="content">Content</div>
        <div id="footer">Footer</div>
    </div>
</body>
</html>
