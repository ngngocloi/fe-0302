<!DOCTYPE html>
<html>
<head>
    
    <meta name="viewport" content="width=device-width" />
    <title>VD1: Dinh dang van ban</title>
    <style type="text/css">
        h2, .p_chartreuse{
            background-color: aqua;
            font-size: 30px;
            font-family: 'Book Antiqua', Caladea;
        }
        p{
            background-color: darksalmon;
            text-align: center;
            text-indent: 2.5rem;
            margin: 5px;
        }
        #p_yellow{
            background-color: yellow;
            border: 2px solid red;
        }
        a:visited{
            color:red;
            text-decoration: none;
        }
        a:hover{
            color: brown;
            background-color: bisque;
            text-decoration: none;
        }
    </style>
</head>

<body>
    <h2> Highlight van ban</h2>
    <p> Day la doan <span class="p_chartreuse"> van ban </span> duoc highlight</p>
    <p>Day la doan <span id="p_yellow"> van ban thu 2</span>duoc highlight</p>
</body>
</html>